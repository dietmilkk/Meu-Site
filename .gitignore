# Downloaded music tracks are committed (volume control needs local files)
# keep index and tracks for site playback

# Python
__pycache__/
*.pyc

# yt-dlp partial downloads
*.part
*.ytdl

# Audio files in wrong place - allow music tracks
*.m4a
*.mp3
!assets/music/tracks/*.m4a
!assets/music/tracks/*.mp3
!assets/music/tracks/**/*.m4a
!assets/music/tracks/**/*.mp3
!assets/music/*.m4a
!assets/music/*.mp3

# Metadata cache
.metadata_cache.json
cookies.txt
